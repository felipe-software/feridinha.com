{
    "name": "api",
    "module": "src/index.ts",
    "type": "module",
    "scripts": {
        "start": "bun ./src/index.ts",
        "dev": "bun --watch ./src/index.ts",
        "assets": "./src/migrators/process-achievements.sh 5 ./assets/achievements && bun ./src/migrators/migrate.ts",
        "test:db:up": "docker compose -f docker-compose.test.yml up -d",
        "test:db:down": "docker compose -f docker-compose.test.yml down -v",
        "test:prisma:setup": "bunx prisma migrate deploy && bunx prisma db push",
        "test:run": "bun test tests/",
        "test:coverage:run": "bun test --coverage tests/",
        "test:coverage": "bun --env-file=.env.test run test:db:up && bun --env-file=.env.test run test:prisma:setup && bun --env-file=.env.test run test:coverage:run; code=$?; bun run test:db:down; exit $code",
        "test": "bun --env-file=.env.test run test:db:up && bun --env-file=.env.test run test:prisma:setup && bun --env-file=.env.test run test:run; code=$?; bun run test:db:down; exit $code",
        "test:simple:run": "bun test tests/simple.test.ts",
        "test:simple": "bun --env-file=.env.test run test:db:up && bun --env-file=.env.test run test:prisma:setup && bun --env-file=.env.test run test:simple:run; code=$?; bun run test:db:down; exit $code"
    },
    "devDependencies": {
        "@types/bun": "^1.3.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/formidable": "^3.4.6",
        "@types/fs-extra": "^11.0.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mime-types": "^2.1.4",
        "@types/tmp": "^0.2.6",
        "bun-types": "^1.3.6"
    },
    "peerDependencies": {
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "@prisma/client": "^6.19.2",
        "@sentry/bun": "^10.66.0",
        "axios": "^1.18.1",
        "body-parser": "^2.2.2",
        "cheerio": "^1.2.0",
        "cors": "^2.8.6",
        "dayjs": "^1.11.19",
        "ejs": "^3.1.10",
        "exiftool-vendored": "^37.0.0",
        "express": "^4.22.1",
        "express-rate-limit": "^7.5.1",
        "formidable": "^3.5.4",
        "fs-extra": "^11.3.3",
        "i18next": "^25.6.0",
        "i18next-http-middleware": "3.9.7",
        "jsonwebtoken": "^9.0.3",
        "mime-types": "^3.0.2",
        "mongodb": "^6.21.0",
        "ms": "^2.1.3",
        "pino": "^9.14.0",
        "pino-loki": "^2.6.0",
        "pino-pretty": "^13.1.3",
        "posthog-node": "^5.45.2",
        "pretty-bytes": "^7.1.0",
        "prisma": "^6.19.2",
        "strict-event-emitter": "^0.5.1",
        "zod": "^3.25.76"
    },
    "overrides": {
        "brace-expansion": "1.1.13",
        "defu": "6.1.7",
        "undici": "7.28.0",
        "minimatch": "3.1.5",
        "path-to-regexp": "0.1.13",
        "@opentelemetry/core": "2.8.0"
    }
}
